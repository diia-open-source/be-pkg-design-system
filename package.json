{
    "name": "@diia-inhouse/design-system",
    "version": "5.30.0",
    "description": "Design system types and utils",
    "license": "MIT",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-pkg-design-system",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./dist/types/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "npm run genproto && tsc && cp -r proto dist/proto",
        "semantic-release": "semantic-release",
        "lint": "oxlint && oxfmt --check . && diia-buf-lint",
        "lint-fix": "oxlint --fix && oxfmt . && diia-buf-lint --fix",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "genproto": "buf generate",
        "proto:breaking": "diia-buf-breaking"
    },
    "dependencies": {
        "@types/node": "25.9.9"
    },
    "devDependencies": {
        "@bufbuild/buf": "1.73.0",
        "@bufbuild/protobuf": "2.16.0",
        "@diia-inhouse/configs": "7.2.3",
        "@diia-inhouse/oxc-config": "6.1.1",
        "lockfile-lint": "5.1.0",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2004",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.9",
        "ts-proto": "2.15.0",
        "typescript": "5.8.3"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "engines": {
        "node": ">=24"
    }
}
